    "src/index-builder/build-index.ts",
    "src/index-builder/content-hash.ts",
    "src/lib/fuzzy-match.ts",
    "src/lib/markdown.ts",
    "src/query/handoff.ts",
    "src/query/load-index.ts",
    "src/query/query.ts",
    "src/reconciliation/reconcile.ts",
    "src/render/data.ts",
