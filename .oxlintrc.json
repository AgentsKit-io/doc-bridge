    "tests/changed-claims.test.ts",
    "tests/cli-controls.test.ts",
    "tests/cli-workflow.test.ts",
    "tests/config-facts.test.ts",
    "tests/discovery-io.test.ts",
    "tests/discovery.test.ts",
    "tests/github-pr.test.ts",
    "tests/index-storage.test.ts",
    "tests/knowledge-entities.test.ts",
    "tests/knowledge-query.test.ts",
    "tests/knowledge-tools.test.ts",
