    "tests/overlay-statistics.test.ts",
    "tests/parity.test.ts",
    "tests/repository-safety.test.ts",
    "tests/service-embed-guide.test.ts",
    "tests/service-hostile-repository.test.ts",
    "tests/service-profile.test.ts",
    "tests/signatures.test.ts",
    "tests/studio.test.ts",
    "tests/vault-diff.test.ts",
    "tests/version-routing.test.ts"
    // baseline:end
  ],
  "overrides": [
    {
      "files": [
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/fixtures/**",
        "**/vitest.setup.*"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "no-unsafe-optional-chaining": "off"
      }
    }
  ]
}
