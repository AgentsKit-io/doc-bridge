{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "prefer-const": "error",
    "prefer-template": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "import/namespace": "off"
  },
  "ignorePatterns": [
    "docs/openapi.json",
    "**/migrations/**",
    "docs/qa/**",
    "apps/api/test/fixtures/**",
    ".changeset/**",
    "dist/**",
    // Adoption baseline (ci-standard/scripts/oxlint-baseline.mjs): files that failed oxlint when the repo moved its lint
    // to oxlint. Generated, only shrinks; a new file is linted strict.
    // baseline:start
    "apps/docs/components/home/drift-findings.tsx",
    "apps/docs/components/home/publication-gate.tsx",
    "apps/docs/components/home/terminal-typing.tsx",
    "apps/docs/lib/source.ts",
    "integrations/obsidian/main.ts",
    "integrations/obsidian/src/core.ts",
    "scripts/action-runner.mjs",
    "scripts/check-no-legacy-chat-imports.mjs",
    "scripts/figures/bridge-conveyor/build.mjs",
    "scripts/figures/bridge-conveyor/leaf.mjs",
    "scripts/lib/readme-standard.mjs",
    "scripts/marketplace-contract.test.mjs",
    "scripts/study-codex-provider.mjs",
    "scripts/study-minimal.mjs",
    "scripts/verification-harness.mjs",
    "skills/doc-bridge-handoff/scripts/resolve-handoff.mjs",
    "src/cli/action.ts",
    "src/cli/operation.ts",
    "src/cli/program.ts",
    "src/cli/service.ts",
    "src/config/load-config.ts",
    "src/conformance/documentation-standard-v1.ts",
    "src/diff/change-set.ts",
    "src/diff/version-routing.ts",
    "src/discovery/changed-claims.ts",
    "src/discovery/coverage.ts",
    "src/discovery/document-targets.ts",
    "src/discovery/entrypoint.ts",
    "src/discovery/facts/cli.ts",
    "src/discovery/facts/config.ts",
    "src/discovery/facts/index.ts",
    "src/discovery/facts/schema-types.ts",
    "src/discovery/facts/signature-compatibility.ts",
    "src/discovery/facts/signature-context.ts",
    "src/discovery/facts/signatures.ts",
    "src/discovery/markdown.ts",
    "src/discovery/obsidian.ts",
    "src/discovery/plugins/built-in.ts",
    "src/discovery/plugins/js-ts.ts",
    "src/discovery/plugins/markdown.ts",
    "src/discovery/plugins/npm-packages.ts",
    "src/discovery/plugins/npm-versions.ts",
    "src/discovery/preload.ts",
    "src/discovery/repository.ts",
    "src/enrich/stage.ts",
    "src/enrich/validate.ts",
    "src/entities/extract.ts",
    "src/execution/config.ts",
    "src/findings/contracts.ts",
    "src/fixes/diff.ts",
