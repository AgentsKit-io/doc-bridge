{
  "schemaVersion": 1,
  "corpus": {
    "agent": {
      "root": "docs/agent-corpus",
      "index": "docs/agent-corpus/OVERVIEW.md"
    },
    "human": {
      "plugin": "plain-markdown",
      "options": {
        "root": "docs",
        "urlPrefix": "/docs"
      }
    }
  },
  "reconciliation": {
    "scope": "package",
    "requiredRelationKinds": ["imports", "re-exports", "depends-on"],
    "requiredRelationTargets": "internal"
  },
  "safety": {
    "exclude": [
      "**/.source/**",
      "**/examples/**",
      "scripts/verification-harness.mjs",
      "**/public/raw/**",
      ".changeset/**",
      ".impeccable.md",
      "**/CLAUDE.md"
    ]
  },
  "audit": {
    "documentation": {
      "generatedPaths": ["apps/docs/AGENTS.md"]
    }
  },
  "routing": {
    "options": {
      "ownership": {
        "doc-bridge": {
          "path": "src",
          "purpose": "CLI, index builder, MCP, gates, and doctor",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/doc-bridge.md",
          "humanDoc": "/docs/POSITIONING"
        },
        "doc-bridge-cli": {
          "path": "src/cli",
          "purpose": "Public ak-docs commands, arguments, output modes, and bundled demo",
          "checks": ["pnpm test", "pnpm typecheck", "node examples/verify-handoff.mjs"],
          "agentDoc": "docs/agent-corpus/cli.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-index": {
          "path": "src/index-builder",
          "purpose": "Corpus scanning, handoff generation, hashes, llms.txt, and watch mode",
          "checks": ["pnpm test", "pnpm typecheck", "node bin/ak-docs.js index"],
          "agentDoc": "docs/agent-corpus/INDEX.md",
          "humanDoc": "/docs/recipes/index-pipeline"
        },
        "doc-bridge-query": {
          "path": "src/query",
          "purpose": "Deterministic package queries, document search, and index loading",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/query.md",
          "humanDoc": "/docs/query"
        },
        "doc-bridge-mcp": {
          "path": "src/mcp",
          "purpose": "MCP stdio server, tool contracts, and client installation",
          "checks": ["pnpm test", "pnpm typecheck", "pnpm smoke:packaged"],
          "agentDoc": "docs/agent-corpus/mcp.md",
          "humanDoc": "/docs/mcp"
        },
        "doc-bridge-gates": {
          "path": "src/gates",
          "purpose": "Freshness, coverage, and documentation link quality gates",
          "checks": ["pnpm test", "node bin/ak-docs.js gate run"],
          "agentDoc": "docs/agent-corpus/gates.md",
          "humanDoc": "/docs/spec/documentation-standard-v1"
        },
        "doc-bridge-conformance": {
          "path": "src/conformance",
          "purpose": "Versioned documentation-standard conformance checks and reports",
          "checks": ["pnpm test", "node bin/ak-docs.js conformance run documentation-standard-v1 --text"],
          "agentDoc": "docs/agent-corpus/conformance.md",
          "humanDoc": "/docs/spec/documentation-standard-v1"
        },
        "doc-bridge-doctor": {
          "path": "src/doctor",
          "purpose": "Repository health scoring, findings, and remediation guidance",
          "checks": ["pnpm test", "node bin/ak-docs.js doctor --text"],
          "agentDoc": "docs/agent-corpus/doctor.md",
          "humanDoc": "/docs/spec/documentation-standard-v1"
        },
        "doc-bridge-memory": {
          "path": "src/memory",
          "purpose": "Reviewable memory ingestion, classification, and documentation promotion",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/memory.md",
          "humanDoc": "/docs/schemas/memory-candidate-v1"
        },
        "doc-bridge-chat": {
          "path": "src/intelligence",
          "purpose": "Optional AgentsKit RAG and chat integration after deterministic resolution",
          "checks": ["pnpm test", "pnpm typecheck", "pnpm docs:typecheck"],
          "agentDoc": "docs/agent-corpus/chat.md",
          "humanDoc": "/docs/chat-and-rag"
        },
        "doc-bridge-agents": {
          "path": "agents",
          "purpose": "Owns the `agents` folder.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/agents.md",
          "humanDoc": "/docs/for-agents"
        },
        "doc-bridge-audit": {
          "path": "src/audit",
          "purpose": "Owns deterministic documentation quality, coverage, and structural validation.",
          "checks": ["pnpm test", "node bin/ak-docs.js audit documentation --json"],
          "agentDoc": "docs/agent-corpus/audit.md",
          "humanDoc": "/docs/spec/documentation-standard-v1"
        },
        "doc-bridge-bench": {
          "path": "src/bench",
          "purpose": "Owns the retrieval benchmark runner, baselines and overlay deltas.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/bench.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-bin": {
          "path": "bin",
          "purpose": "Owns the two executables `package.json` publishes, and nothing else.",
          "checks": ["pnpm test", "pnpm smoke:packaged"],
          "agentDoc": "docs/agent-corpus/bin.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-brief": {
          "path": "src/brief",
          "purpose": "Owns the ticket brief a production line attaches to an agent's task.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/brief.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-budget": {
          "path": "src/budget",
          "purpose": "Owns token counting and message trimming under a budget, mirroring `@agentskit/core` algorithms",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/budget.md",
          "humanDoc": "/docs/spec/config-v1"
        },
        "doc-bridge-changelog": {
          "path": "changelog.d",
          "purpose": "Owns per-PR changelog fragments.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/changelog.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-changeset": {
          "path": ".changeset",
          "purpose": "Owns the Changesets release configuration used by maintainers for versioned releases.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/changeset.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-claude-plugin": {
          "path": ".claude-plugin",
          "purpose": "Owns the Claude plugin manifest that exposes the handoff resolver.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/claude-plugin.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-codex": {
          "path": ".codex",
          "purpose": "Owns the Codex verification manifest listing the checks an agent runs before finishing.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/codex.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-config": {
          "path": "src/config",
          "purpose": "Owns finding, parsing, validating and defaulting the repository's configuration, and the enums every",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/config.md",
          "humanDoc": "/docs/spec/config-v1"
        },
        "doc-bridge-cursor-plugin": {
          "path": ".cursor-plugin",
          "purpose": "Owns the Cursor plugin manifest that exposes the handoff resolver.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/cursor-plugin.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-diff": {
          "path": "src/diff",
          "purpose": "Owns change-set computation under `src/diff`.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/diff.md",
          "humanDoc": "/docs/spec/change-set-v1"
        },
        "doc-bridge-discovery": {
          "path": "src/discovery",
          "purpose": "Owns repository discovery: areas, coverage, document targets, identity, entrypoints and facts.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/discovery.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-docs-app": {
          "path": "apps/docs",
          "purpose": "Owns the Next.js documentation site, its generated raw exports and `public-agent-docs.json`.",
          "checks": ["pnpm docs:typecheck"],
          "agentDoc": "docs/agent-corpus/docs-app.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-docs": {
          "path": "docs",
          "purpose": "Owns the human documentation tree (specs, schemas, guides, recipes).",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/docs.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-enrich": {
          "path": "src/enrich",
          "purpose": "Owns the opt-in enrichment pipeline under `src/enrich`: proposals from an agent are validated against the index, stored in an overlay, and only take effect once approved.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/enrich.md",
          "humanDoc": "/docs/spec/knowledge-query-v1"
        },
        "doc-bridge-entities": {
          "path": "src/entities",
          "purpose": "Owns knowledge-entity extraction in `src/entities/extract.ts`.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/entities.md",
          "humanDoc": "/docs/spec/knowledge-query-v1"
        },
        "doc-bridge-examples": {
          "path": "examples",
          "purpose": "Owns runnable example configs and demo repositories used by quickstarts and handoff verification.",
          "checks": ["node examples/verify-handoff.mjs"],
          "agentDoc": "docs/agent-corpus/examples.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-execution": {
          "path": "src/execution",
          "purpose": "Owns the execution profile under `src/execution`.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/execution.md",
          "humanDoc": "/docs/spec/service-profile-v1"
        },
        "doc-bridge-federation": {
          "path": "src/federation",
          "purpose": "Owns loading external llms.txt sources, parsing chunks from remote and local markdown, scoring",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/federation.md",
          "humanDoc": "/docs/spec/config-v1"
        },
        "doc-bridge-findings": {
          "path": "src/findings",
          "purpose": "Owns normalizing internal diagnostics to the ecosystem `Finding` shape.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/findings.md",
          "humanDoc": "/docs/spec/documentation-standard-v1"
        },
        "doc-bridge-fixes": {
          "path": "src/fixes",
          "purpose": "Owns proposing and applying fix proposals with approval gates and integrity verification.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/fixes.md",
          "humanDoc": "/docs/POSITIONING"
        },
        "doc-bridge-github": {
          "path": ".github",
          "purpose": "Owns CI workflows, CODEOWNERS, the PR template and the factory playbook.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/github.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-graph": {
          "path": "src/graph",
          "purpose": "Owns graph construction from the index and from reviewed memory.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/graph.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-integrations": {
          "path": "integrations",
          "purpose": "Owns the `integrations` folder, which holds the Obsidian plugin in `integrations/obsidian` (see its `README.md` and `main.ts`).",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/integrations.md",
          "humanDoc": "/docs/for-agents"
        },
        "doc-bridge-lib": {
          "path": "src/lib",
          "purpose": "Owns the small shared helpers the rest of the tree depends on.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/lib.md",
          "humanDoc": "/docs/POSITIONING"
        },
        "doc-bridge-mcpb": {
          "path": "mcpb",
          "purpose": "Owns the MCP bundle manifest and icon for packaged installs.",
          "checks": ["pnpm test"],
          "agentDoc": "docs/agent-corpus/mcpb.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-metrics": {
          "path": "src/metrics",
          "purpose": "Owns benchmark measurement for entity, relation, and finding precision and recall, and efficiency",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/metrics.md",
          "humanDoc": "/docs/query"
        },
        "doc-bridge-parity": {
          "path": "src/parity",
          "purpose": "Owns detecting when public sentences have drifted from repository facts and reporting findings",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/parity.md",
          "humanDoc": "/docs/RELEASE"
        },
        "doc-bridge-playbook": {
          "path": "src/playbook",
          "purpose": "Owns the Doc Bridge Pattern playbook content and metadata.",
          "checks": ["pnpm test", "node bin/ak-docs.js index"],
          "agentDoc": "docs/agent-corpus/playbook.md",
          "humanDoc": "/docs/playbook/doc-bridge-pattern"
        },
        "doc-bridge-plugins": {
          "path": "src/plugins",
          "purpose": "Owns the analyzer plugin contract and registry.",
          "checks": ["pnpm test", "node bin/ak-docs.js index"],
          "agentDoc": "docs/agent-corpus/plugins.md",
          "humanDoc": "/docs/spec/config-v1"
        },
        "doc-bridge-reconciliation": {
          "path": "src/reconciliation",
          "purpose": "Owns reconciliation of documented claims against discovered code facts, scoped per package.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/reconciliation.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-render": {
          "path": "src/render",
          "purpose": "Owns template-driven rendering of canonical artifacts (`llms.txt`, area, ownership, change digest) to Markdown.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/render.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-report": {
          "path": "src/report",
          "purpose": "Owns the offline HTML report: a snapshot and its reconciliation rendered into something a person can",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/report.md",
          "humanDoc": "/docs/for-agents"
        },
        "doc-bridge-retrieval": {
          "path": "src/retrieval",
          "purpose": "Owns the projection from a discovery snapshot to the sealed retrieval index, and the ranking over it.",
          "checks": ["pnpm test", "node bin/ak-docs.js index"],
          "agentDoc": "docs/agent-corpus/retrieval.md",
          "humanDoc": "/docs/query"
        },
        "doc-bridge-retriever": {
          "path": "src/retriever",
          "purpose": "Owns the document retriever that answers queries from the deterministic index before any optional model is involved.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/retriever.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-rules": {
          "path": "src/rules",
          "purpose": "Owns turning reconciliation diagnostics into severity-carrying findings.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/rules.md",
          "humanDoc": "/docs/spec/documentation-standard-v1"
        },
        "doc-bridge-safety": {
          "path": "src/safety",
          "purpose": "Owns safe file discovery and secret detection.",
          "checks": ["pnpm test", "node bin/ak-docs.js index"],
          "agentDoc": "docs/agent-corpus/safety.md",
          "humanDoc": "/docs/spec/config-v1"
        },
        "doc-bridge-schemas": {
          "path": "src/schemas",
          "purpose": "Owns the artifact contracts: every sealed artifact this repository writes or reads is shaped here, and",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/schemas.md",
          "humanDoc": "/docs/schemas/doc-bridge-index-v1"
        },
        "doc-bridge-scripts": {
          "path": "scripts",
          "purpose": "Owns the repository's build, release and verification tasks — the checks that cannot live in the test",
          "checks": ["pnpm test", "pnpm check:ecosystem-upstream"],
          "agentDoc": "docs/agent-corpus/scripts.md",
          "humanDoc": "/docs/RELEASE"
        },
        "doc-bridge-shims": {
          "path": "src/shims",
          "purpose": "Owns ambient type declarations for what the published packages do not type correctly themselves.",
          "checks": ["pnpm typecheck", "pnpm test"],
          "agentDoc": "docs/agent-corpus/shims.md",
          "humanDoc": "/docs/POSITIONING"
        },
        "doc-bridge-skills": {
          "path": "skills",
          "purpose": "Owns the portable Agent Skills packaging of the handoff resolver (`skills/doc-bridge-handoff`).",
          "checks": ["pnpm test"],
          "agentDoc": "docs/agent-corpus/skills.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-src-agents": {
          "path": "src/agents",
          "purpose": "Owns the registry adapter that exposes agent definitions to the AgentsKit registry.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/src-agents.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-storage": {
          "path": "src/storage",
          "purpose": "Owns local artifact and fact storage and its operation contract.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/storage.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-studio": {
          "path": "src/studio",
          "purpose": "Owns the studio graph projection in `src/studio/export.ts`.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/studio.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-study": {
          "path": "src/study",
          "purpose": "Owns the documentation efficiency study protocol: expectations, execution, metrics, adjudication and provider telemetry.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/study.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-tests": {
          "path": "tests",
          "purpose": "Owns the vitest suites.",
          "checks": ["pnpm test"],
          "agentDoc": "docs/agent-corpus/tests.md",
          "humanDoc": "/docs/spec/cli"
        },
        "doc-bridge-vault": {
          "path": "src/vault",
          "purpose": "Owns the Markdown vault export under `src/vault`.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/vault.md",
          "humanDoc": "/docs/guides/vault"
        },
        "doc-bridge-workflow": {
          "path": "src/workflow",
          "purpose": "Owns the workflow engine that sequences deterministic steps for the loop workflow.",
          "checks": ["pnpm test", "pnpm typecheck"],
          "agentDoc": "docs/agent-corpus/workflow.md",
          "humanDoc": "/docs/spec/cli"
        }
      }
    }
  },
  "gates": {
    "preset": "minimal",
    "include": ["documentation-standard-v1", "index-reproducible"]
  },
  "conformance": {
    "documentationStandardV1": {
      "rawSources": ["README.md", "docs/getting-started.md", "docs/for-agents.md", "docs/spec/cli.md"],
      "contributionPaths": ["CONTRIBUTING.md"],
      "metadata": [
        {
          "path": "docs/landing/index.html",
          "contains": ["<title>", "name=\"description\""]
        },
        {
          "path": "apps/docs/app/layout.tsx",
          "contains": ["title:", "description:", "openGraph", "twitter"]
        }
      ],
      "links": [
        {
          "url": "https://www.agentskit.io",
          "paths": ["README.md"]
        },
        {
          "url": "https://registry.agentskit.io/",
          "paths": ["README.md"]
        },
        {
          "url": "https://chat.agentskit.io",
          "paths": ["README.md"]
        },
        {
          "url": "https://code-review.agentskit.io",
          "paths": ["README.md"]
        },
        {
          "url": "https://harness.agentskit.io/",
          "paths": ["README.md"]
        }
      ],
      "ecosystemContract": {
        "manifest": "ecosystem.json",
        "claims": "ecosystem-claims.json",
        "productId": "doc-bridge"
      },
      "quickstarts": [
        {
          "id": "demo",
          "doc": "README.md",
          "test": "tests/demo-mcp.test.ts",
          "command": "pnpm vitest run tests/demo-mcp.test.ts",
          "testContains": ["runs bundled example demo", "runDemo"]
        }
      ],
      "visuals": [
        "apps/docs/app/icon.svg",
        "docs/landing/assets/doc-bridge-hero.webp",
        "docs/landing/assets/doc-bridge-two-way.webp",
        "docs/landing/assets/doc-bridge-surfaces.webp"
      ],
      "diagrams": [
        {
          "path": "docs/spec/documentation-standard-v1.md",
          "contains": ["```mermaid"]
        }
      ]
    }
  }
}
