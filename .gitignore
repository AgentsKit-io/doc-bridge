node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
# Unanchored on purpose, like the `llms.txt` rule below: every fixture project a test indexes
# writes its own `.doc-bridge/`. The contents are excluded rather than the directory, because Git
# cannot re-include a file whose parent directory is excluded.
**/.doc-bridge/*
# …except this repository's own index, anchored with a leading slash so no fixture is rescued. It
# is the artifact `index-freshness` verifies, and a gate cannot verify what it regenerates first:
# committing it is the whole point of the check, and what every consumer is told to do.
# `workflow/` stays out — run state, and 191 MB of it.
!/.doc-bridge/index.json
llms.txt
# …except a golden: that one is a fixture the render tests compare against, not an artifact a
# build wrote. The pattern above is unanchored on purpose, since every fixture project a test
# indexes writes its own llms.txt.
!tests/golden/**/llms.txt
*.tgz
apps/docs/.next/
apps/docs/.source/
apps/docs/out/
apps/docs/public/
playwright-report/
test-results/
.lighthouseci/
node_modules
.mcpb-build/
.mcpb-deploy/
.mcpb-output/
.mcpb-runtime/

# Claude Code creates a git worktree per isolated agent run under here. Transient session
# state, never source — and a checkout inside the checkout, which nothing should track.
.claude/worktrees/

# @agentskit/harness keep-pushing loop.
# loop.config.yaml identifies a Linear workspace and person; only the example is tracked.
loop.config.yaml
loop.config.local.yaml
.codex/loop/
