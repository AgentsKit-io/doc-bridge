{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "confidence", "reasonCodes", "inputTokens", "outputTokens", "tokenMethod", "measurements"],
  "properties": {
    "outcome": { "type": "string", "enum": ["success", "partial", "incorrect", "incomplete", "blocked"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasonCodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" }, "maxItems": 16 },
    "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "tokenMethod": { "type": ["string", "null"], "enum": ["provider", "estimate", null] },
    "measurements": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  }
}
